# Copy to /etc/caddy/Caddyfile and replace mcp.example.com.
# Public entry: HTTPS :443 only. Never publish :8765.
mcp.example.com {
	encode zstd gzip

	request_body {
		max_size 4MB
	}

	reverse_proxy 127.0.0.1:8765 {
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}

	log {
		output file /var/log/caddy/mcp.example.com.log
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Api-Key delete
			}
		}
	}
}
