# Copy to /etc/codeagent-mcp/http.env (mode 0640 root:codeagent-mcp).
# Never commit real secrets.

# --- Public identity ---
CODEAGENT_HOST=mcp.example.com
CODEAGENT_BASE_URL=https://mcp.example.com

# --- GitHub OAuth App ---
# Authorization callback URL must be exactly: ${CODEAGENT_BASE_URL}/auth/callback
CODEAGENT_GITHUB_CLIENT_ID=
CODEAGENT_GITHUB_CLIENT_SECRET=
CODEAGENT_OAUTH_REDIRECT_PATH=/auth/callback

# CSV of GitHub OAuth subject claims (stable). Fail-closed if empty with auth on.
# Capture `sub` after first successful login (audit/logs), then restart.
CODEAGENT_ALLOWED_SUBS=

# Persistent FastMCP JWT signing key (openssl rand -hex 32). Rotating forces re-auth.
CODEAGENT_JWT_SIGNING_KEY=

# --- HTTP bind (loopback only) ---
CODEAGENT_HTTP_HOST=127.0.0.1
CODEAGENT_HTTP_PORT=8765
CODEAGENT_MCP_PATH=/mcp/

# --- State under service HOME ---
CODEAGENT_LEASE_TTL_S=2700
CODEAGENT_LEASE_STORE=/var/lib/codeagent-mcp/leases.json
CODEAGENT_TMUX_SOCKET=/var/lib/codeagent-mcp/tmux/tmux.sock
CODEAGENT_TMUX_CONF=/var/lib/codeagent-mcp/tmux/tmux.conf
CODEAGENT_TMUX_TMPDIR=/var/lib/codeagent-mcp/tmux
CODEAGENT_TERMINAL_STORE=/var/lib/codeagent-mcp/terminals.json
XDG_RUNTIME_DIR=/run/user/REPLACE_WITH_CODEAGENT_UID
CODEAGENT_SPOOL_ROOT=/var/lib/codeagent-mcp/spool
CODEAGENT_SPOOL_TTL_S=86400
PLAYWRIGHT_BROWSERS_PATH=/var/lib/codeagent-mcp/playwright
CODEAGENT_BROWSER_PROFILE=/var/lib/codeagent-mcp/browser-profile
CODEAGENT_ARTIFACT_ROOT=/var/lib/codeagent-mcp/artifacts
CODEAGENT_ARTIFACT_TTL_S=86400
CODEAGENT_ARTIFACT_LEASE_QUOTA=50
CODEAGENT_HTTP_RATE_LIMIT=120
CODEAGENT_HTTP_RATE_WINDOW_S=60

# Server-side project registry (copy deploy/projects.example.yaml and edit roots)
CODEAGENT_PROJECTS_FILE=/etc/codeagent-mcp/projects.yaml

# Optional write gates referenced by writable_env keys in projects.yaml
# CODEAGENT_EXAMPLE_WRITE=0

# Private temp for tempfile/pytest/Playwright scratch (do not allowlist TMPDIR in exec_run)
TMPDIR=/var/lib/codeagent-mcp/tmp
TEMP=/var/lib/codeagent-mcp/tmp
TMP=/var/lib/codeagent-mcp/tmp
